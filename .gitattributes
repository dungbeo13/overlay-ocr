# Windows scripts keep CRLF in every checkout (cmd.exe misreads LF-only batch files)
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and docs are LF in the repository and on disk
*.py text eol=lf
*.md text eol=lf

# Binary files: never converted or diffed as text
*.png binary
*.ico binary
*.gguf binary
