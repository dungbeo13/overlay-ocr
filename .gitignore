# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Per-user data: config.json, profiles, translation cache, lookup cache/state, logs
/data/

# Benchmark output (logs, e2e dumps, screenshots, previews; regenerated by the bench scripts)
/bench/results/

# Your own bench material: real game / manga screenshots and lines belong to their owners, never commit them.
# synthetic_quick/ is the throwaway output of `bench.make_ocr_samples --quick`.
/bench/data/ocr/real/
/bench/data/ocr/synthetic_quick/
/bench/data/translate/local/

# Models and other large downloads live in %USERPROFILE%\.screen-translator, never here
*.gguf
*.safetensors

# Logs and editor/OS clutter
*.log
*.log.[0-9]
.vscode/
.idea/
Thumbs.db
desktop.ini
